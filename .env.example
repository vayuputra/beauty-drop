# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Server
PORT=5000
NODE_ENV=development
SESSION_SECRET=generate-with-openssl-rand-hex-32   # required in production, 32+ chars

# Operators: comma-separated emails allowed to run bulk refreshes, analytics, cache control
ADMIN_EMAILS=you@example.com

# Vercel Cron sends this as a bearer token to /api/cron/* routes
CRON_SECRET=generate-a-long-random-string

# Extra origins allowed to make state-changing API calls (Capacitor origins are built in)
ALLOWED_ORIGINS=

# Native builds only: the deployed API origin the mobile app talks to
VITE_API_BASE_URL=https://yourdomain.com

# Google OAuth 2.0 (optional in development; email/password sign-in always works)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_CALLBACK_URL=https://yourdomain.com/api/callback

# OpenAI (for AI review synthesis, image verification)
OPENAI_API_KEY=sk-your-openai-key   # AI_INTEGRATIONS_OPENAI_API_KEY also accepted
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Perplexity AI (for influencer discovery, product image search)
PERPLEXITY_API_KEY=pplx-your-key

# Checkout agent (Phase 3)
ADDRESS_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32   # required in production to save addresses
AMAZON_ASSOCIATE_TAG_US=                                      # optional: your Amazon Associates tag
AMAZON_ASSOCIATE_TAG_IN=

# Live data (Phase 1). Each is optional; without it that job is skipped and the app says so.
SERPAPI_KEY=your-serpapi-key          # Google Shopping: prices at other sellers
YOUTUBE_API_KEY=your-youtube-data-api-key   # creator review videos
# Tuning (defaults shown)
# LAUNCH_WINDOW_DAYS=45    # how recent a brand-store product must be to count as a new drop
# LAUNCH_MAX_PAGES=2       # products.json pages (250 each) read per store per run
# PRICE_BATCH_SIZE=5       # products compared per run
# PRICE_MAX_AGE_HOURS=12
# CONTENT_BATCH_SIZE=4     # each product costs 100 of YouTube's 10,000 daily quota units
# CONTENT_MAX_AGE_HOURS=72

# Legacy Python price fetcher (superseded by the Node ingestion jobs; admin tools only)
PYTHON_FETCHER_URL=http://localhost:8000   # leave unset to disable live price refresh
PRICE_FETCHER_TOKEN=shared-secret-between-api-and-fetcher

# Python Fetcher Environment
PYTHON_FETCHER_PORT=8000
